{
  "cleanUrls": true,
  "functions": {
    "api/market.js": {
      "maxDuration": 30
    },
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/cron/snapshot.js": {
      "maxDuration": 60
    },
    "api/cron/scan.js": {
      "maxDuration": 60
    },
    "api/ops.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/snapshot",
      "schedule": "20 4 * * *"
    },
    {
      "path": "/api/cron/scan",
      "schedule": "35 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}
